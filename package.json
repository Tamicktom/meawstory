{
  "name": "meawstory",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "docker compose up -d && bun run --bun next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun playwright test",
    "test:e2e": "playwright test --project=e2e",
    "test:ct": "playwright test --project=components",
    "doctor": "npx react-doctor@latest",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:studio": "npx drizzle-kit studio",
    "db:migrate:fresh": "bun scripts/migrate-fresh.ts",
    "db:seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.96",
