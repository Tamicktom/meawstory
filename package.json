    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0",
    "workflow": "^5.2.2",
    "zod": "^4.6.7"
