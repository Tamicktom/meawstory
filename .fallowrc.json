{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "playwright/gallery/main.tsx",
    "playwright/vite.config.ts",
    "components/**/*.story.tsx"
  ],
  "ignorePatterns": ["**/*.css"],
  "ignoreDependencies": [
    "@tailwindcss/typography",
    "shadcn",
    "tw-animate-css"
  ],
  "ignoreExports": [
    {
      "file": "playwright/mocks/next-navigation.ts",
      "exports": ["useRouter"]
    }
  ]
}
